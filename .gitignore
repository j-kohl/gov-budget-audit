# Ingested data — raw store, Parquet staging, DuckDB. Reproducible from source.
# Anchored to the repo root: the dashboard's committed aggregates live in
# dashboard/src/data and an unanchored 'data/' would swallow them.
/data/

# Secrets — API keys belong in the environment, never in the repo
.env
.env.*
!.env.example

